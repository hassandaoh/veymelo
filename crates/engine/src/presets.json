    {"id": "plasma", "name": "Plasma", "category": "background", "about": "bright plasma whose colours cycle on and on", "effects": [{"type": "fractalNoise", "name": "Plasma", "props": {"scale": 300, "contrast": 150, "complexity": 3}, "expressions": {"evolution": "time * 15"}}, {"type": "colorama", "name": "Plasma Colours", "expressions": {"phaseShift": "time * 40"}, "props": {"cycleRepetitions": 3}}]},
    {"id": "cellDrift", "name": "Cell Drift", "category": "background", "about": "bubble-like cells slowly swell and merge in teal", "effects": [{"type": "cellPattern", "name": "Cells", "props": {"size": {"ofLayer": 0.08}, "contrast": 140}, "expressions": {"evolution": "time * 25"}}, {"type": "tint", "name": "Teal", "props": {"mapBlackTo": "#032b2f", "mapWhiteTo": "#5ff0d9"}}]},
    {"id": "crystalFacets", "name": "Crystal Facets", "category": "background", "about": "sharp facets shimmer in warm violet light", "effects": [{"type": "cellPattern", "name": "Facets", "props": {"cellPattern": "crystals", "size": {"ofLayer": 0.1}}, "expressions": {"evolution": "time * 12"}}, {"type": "tint", "name": "Violet", "props": {"mapBlackTo": "#1a0630", "mapWhiteTo": "#f0b8ff"}}]},
    {"id": "tileMosaic", "name": "Tile Mosaic", "category": "background", "about": "square tiles glow and fade as fog drifts under them", "effects": [{"type": "fractalNoise", "name": "Glow", "props": {"scale": 400, "contrast": 170, "brightness": -10}, "expressions": {"evolution": "time * 15", "offsetTurbulence": "value + [time * thisLayer.width * 0.03, 0]"}}, {"type": "mosaic", "name": "Tiles", "props": {"horizontalBlocks": 32, "verticalBlocks": 18}}, {"type": "tint", "name": "Tile Colour", "props": {"mapBlackTo": "#08131f", "mapWhiteTo": "#4fc3ff"}}]},
    {"id": "mirroredSilk", "name": "Mirrored Silk", "category": "background", "about": "flowing silk ribbons mirrored down the middle", "effects": [{"type": "fractalNoise", "name": "Silk", "props": {"fractalType": "dynamicTwist", "uniformScaling": false, "scaleWidth": 300, "scaleHeight": 120, "contrast": 130}, "expressions": {"evolution": "time * 20"}}, {"type": "mirror", "name": "Mirror", "props": {"reflectionCenter": {"ofLayer": [0.5, 0.5]}}}, {"type": "tint", "name": "Silk Colour", "props": {"mapBlackTo": "#2a0010", "mapWhiteTo": "#ffc9d9"}}]},
