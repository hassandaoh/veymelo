{
  "presets": [
    {"id": "fadeIn", "name": "Fade In", "category": "in", "length": 0.5, "about": "from see-through to solid", "layer": {"ease": "easy", "keys": {"transform/opacity": [[0, 0], [1, {"current": true}]]}}},
    {"id": "fadeOut", "name": "Fade Out", "category": "out", "length": 0.5, "at": "out", "about": "from solid to see-through, ending at its out point", "layer": {"ease": "easy", "keys": {"transform/opacity": [[0, {"current": true}], [1, 0]]}}},
    {"id": "slideInLeft", "name": "Slide In from the Left", "category": "in", "length": 0.6, "about": "comes in from just past the left edge and slows to a stop", "layer": {"ease": "easyIn", "keys": {"transform/position": [[0, {"off": "left"}], [1, {"current": true}]]}}},
    {"id": "slideInRight", "name": "Slide In from the Right", "category": "in", "length": 0.6, "about": "comes in from just past the right edge and slows to a stop", "layer": {"ease": "easyIn", "keys": {"transform/position": [[0, {"off": "right"}], [1, {"current": true}]]}}},
    {"id": "slideInTop", "name": "Slide In from the Top", "category": "in", "length": 0.6, "about": "comes down from just past the top and slows to a stop", "layer": {"ease": "easyIn", "keys": {"transform/position": [[0, {"off": "top"}], [1, {"current": true}]]}}},
    {"id": "slideInBottom", "name": "Slide In from the Bottom", "category": "in", "length": 0.6, "about": "comes up from just past the bottom and slows to a stop", "layer": {"ease": "easyIn", "keys": {"transform/position": [[0, {"off": "bottom"}], [1, {"current": true}]]}}},
    {"id": "slideOutLeft", "name": "Slide Out to the Left", "category": "out", "length": 0.6, "at": "out", "about": "speeds away past the left edge", "layer": {"ease": "easyOut", "keys": {"transform/position": [[0, {"current": true}], [1, {"off": "left"}]]}}},
    {"id": "slideOutRight", "name": "Slide Out to the Right", "category": "out", "length": 0.6, "at": "out", "about": "speeds away past the right edge", "layer": {"ease": "easyOut", "keys": {"transform/position": [[0, {"current": true}], [1, {"off": "right"}]]}}},
    {"id": "slideOutTop", "name": "Slide Out to the Top", "category": "out", "length": 0.6, "at": "out", "about": "speeds away past the top", "layer": {"ease": "easyOut", "keys": {"transform/position": [[0, {"current": true}], [1, {"off": "top"}]]}}},
    {"id": "slideOutBottom", "name": "Slide Out to the Bottom", "category": "out", "length": 0.6, "at": "out", "about": "speeds away past the bottom", "layer": {"ease": "easyOut", "keys": {"transform/position": [[0, {"current": true}], [1, {"off": "bottom"}]]}}},
    {"id": "popIn", "name": "Pop In", "category": "in", "length": 0.5, "about": "grows from nothing a little past its size, then settles", "layer": {"ease": "easy", "keys": {"transform/scale": [[0, {"times": 0}], [0.65, {"times": 1.12}], [1, {"current": true}]], "transform/opacity": [[0, 0], [0.3, {"current": true}]]}}},
    {"id": "popOut", "name": "Pop Out", "category": "out", "length": 0.4, "at": "out", "about": "swells a little, then shrinks to nothing", "layer": {"ease": "easy", "keys": {"transform/scale": [[0, {"current": true}], [0.35, {"times": 1.12}], [1, {"times": 0}]]}}},
    {"id": "spinIn", "name": "Spin In", "category": "in", "length": 0.7, "about": "turns in from half a turn back as it grows", "layer": {"ease": "easy", "keys": {"transform/rotation": [[0, {"by": -180}], [1, {"current": true}]], "transform/scale": [[0, {"times": 0}], [1, {"current": true}]]}}},
    {"id": "zoomIn", "name": "Zoom In", "category": "in", "length": 0.6, "about": "comes from big and see-through down to its size", "layer": {"ease": "easyIn", "keys": {"transform/scale": [[0, {"times": 2.5}], [1, {"current": true}]], "transform/opacity": [[0, 0], [0.6, {"current": true}]]}}},
    {"id": "blurIn", "name": "Blur In", "category": "in", "length": 0.6, "about": "comes into focus as it fades in", "layer": {"ease": "easy", "keys": {"transform/opacity": [[0, 0], [0.5, {"current": true}]]}}, "effects": [{"type": "gaussianBlur", "name": "Blur In", "ease": "easy", "keys": {"blurriness": [[0, 40], [1, 0]]}}]},
    {"id": "blurOut", "name": "Blur Out", "category": "out", "length": 0.6, "at": "out", "about": "goes out of focus as it fades out", "layer": {"ease": "easy", "keys": {"transform/opacity": [[0.5, {"current": true}], [1, 0]]}}, "effects": [{"type": "gaussianBlur", "name": "Blur Out", "ease": "easy", "keys": {"blurriness": [[0, 0], [1, 40]]}}]},
    {"id": "dropIn", "name": "Drop In", "category": "in", "length": 0.9, "about": "falls in from just past the top and bounces to rest", "layer": {"keys": {"transform/position": [[0, {"off": "top"}, "easyOut"], [0.45, {"current": true}], [0.62, {"by": [0, -40]}, "easy"], [0.78, {"current": true}], [0.88, {"by": [0, -12]}, "easy"], [1, {"current": true}]]}}},
    {"id": "wipeInLeft", "name": "Wipe In from the Left", "category": "in", "length": 1.0, "about": "a soft edge sweeps in from the left and shows it", "effects": [{"type": "linearWipe", "name": "Wipe In from the Left", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"wipeAngle": 270, "feather": {"ofLayer": 0.08}}}]},
    {"id": "wipeInRight", "name": "Wipe In from the Right", "category": "in", "length": 1.0, "about": "a soft edge sweeps in from the right and shows it", "effects": [{"type": "linearWipe", "name": "Wipe In from the Right", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"wipeAngle": 90, "feather": {"ofLayer": 0.08}}}]},
    {"id": "wipeInTop", "name": "Wipe In from the Top", "category": "in", "length": 1.0, "about": "shown from its top edge down", "effects": [{"type": "linearWipe", "name": "Wipe In from the Top", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"wipeAngle": 0, "feather": {"ofLayer": 0.08}}}]},
    {"id": "wipeInBottom", "name": "Wipe In from the Bottom", "category": "in", "length": 1.0, "about": "shown from its bottom edge up", "effects": [{"type": "linearWipe", "name": "Wipe In from the Bottom", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"wipeAngle": 180, "feather": {"ofLayer": 0.08}}}]},
    {"id": "diagonalSweepIn", "name": "Diagonal Sweep In", "category": "in", "length": 1.0, "about": "a wide, very soft edge sweeps in from the lower left", "effects": [{"type": "linearWipe", "name": "Diagonal Sweep In", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"wipeAngle": 225, "feather": {"ofLayer": 0.35}}}]},
    {"id": "wipeOutLeft", "name": "Wipe Out to the Left", "category": "out", "length": 1.0, "about": "a soft edge takes it away towards the left", "effects": [{"type": "linearWipe", "name": "Wipe Out to the Left", "ease": "easy", "keys": {"transitionCompletion": [[0, 0], [1, 100]]}, "props": {"wipeAngle": 270, "feather": {"ofLayer": 0.08}}}], "at": "out"},
    {"id": "wipeOutRight", "name": "Wipe Out to the Right", "category": "out", "length": 1.0, "about": "a soft edge takes it away towards the right", "effects": [{"type": "linearWipe", "name": "Wipe Out to the Right", "ease": "easy", "keys": {"transitionCompletion": [[0, 0], [1, 100]]}, "props": {"wipeAngle": 90, "feather": {"ofLayer": 0.08}}}], "at": "out"},
    {"id": "clockReveal", "name": "Clock Reveal", "category": "in", "length": 1.0, "about": "a clock hand sweeps once round its middle and shows it", "effects": [{"type": "radialWipe", "name": "Clock Reveal", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"wipe": "counterclockwise", "feather": 4}}]},
    {"id": "fanOpen", "name": "Fan Open", "category": "in", "length": 1.0, "about": "opens like a fan, from the top down both sides", "effects": [{"type": "radialWipe", "name": "Fan Open", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"wipe": "both", "startAngle": 180, "feather": 4}}]},
    {"id": "clockWipeOut", "name": "Clock Wipe Out", "category": "out", "length": 1.0, "about": "a clock hand sweeps once round its middle and takes it away", "effects": [{"type": "radialWipe", "name": "Clock Wipe Out", "ease": "easy", "keys": {"transitionCompletion": [[0, 0], [1, 100]]}, "props": {"wipe": "clockwise", "feather": 4}}], "at": "out"},
    {"id": "irisOpen", "name": "Iris Open", "category": "in", "length": 1.0, "about": "a widening circle shows it from the middle", "effects": [{"type": "irisWipe", "name": "Iris Open", "ease": "easy", "keys": {"outerRadius": [[0, 0], [1, {"ofLayer": 0.55}]]}, "props": {"irisPoints": 32, "feather": {"ofLayer": 0.02}}}]},
    {"id": "irisClose", "name": "Iris Close", "category": "out", "length": 1.0, "about": "a closing circle takes it away to the middle", "effects": [{"type": "irisWipe", "name": "Iris Close", "ease": "easy", "keys": {"outerRadius": [[0, {"ofLayer": 0.55}], [1, 0]]}, "props": {"irisPoints": 32, "feather": {"ofLayer": 0.02}}}], "at": "out"},
    {"id": "blindsOpen", "name": "Blinds Open", "category": "in", "length": 1.0, "about": "upright slats widen until it is whole", "effects": [{"type": "venetianBlinds", "name": "Blinds Open", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"direction": 0, "width": {"ofLayer": 0.06}}}]},
    {"id": "slatsDown", "name": "Slats Down", "category": "in", "length": 1.0, "about": "flat slats thicken until it is whole", "effects": [{"type": "venetianBlinds", "name": "Slats Down", "ease": "easy", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"direction": 90, "width": {"ofLayer": 0.06}}}]},
    {"id": "blindsClose", "name": "Blinds Close", "category": "out", "length": 1.0, "about": "upright slats narrow until it is gone", "effects": [{"type": "venetianBlinds", "name": "Blinds Close", "ease": "easy", "keys": {"transitionCompletion": [[0, 0], [1, 100]]}, "props": {"direction": 0, "width": {"ofLayer": 0.06}}}], "at": "out"},
    {"id": "pixelDissolveIn", "name": "Pixel Dissolve In", "category": "in", "length": 1.0, "about": "small hard blocks pop in at random until it is whole", "effects": [{"type": "blockDissolve", "name": "Pixel Dissolve In", "ease": "linear", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"blockWidth": 6, "blockHeight": 6, "softEdges": false}}]},
    {"id": "mosaicFadeIn", "name": "Mosaic Fade In", "category": "in", "length": 1.0, "about": "large soft tiles fade in at random", "effects": [{"type": "blockDissolve", "name": "Mosaic Fade In", "ease": "linear", "keys": {"transitionCompletion": [[0, 100], [1, 0]]}, "props": {"blockWidth": {"ofLayer": 0.08}, "blockHeight": {"ofLayer": 0.08}, "feather": 12}}]},
    {"id": "pixelDissolveOut", "name": "Pixel Dissolve Out", "category": "out", "length": 1.0, "about": "small hard blocks drop out at random until it is gone", "effects": [{"type": "blockDissolve", "name": "Pixel Dissolve Out", "ease": "linear", "keys": {"transitionCompletion": [[0, 0], [1, 100]]}, "props": {"blockWidth": 6, "blockHeight": 6, "softEdges": false}}], "at": "out"},
    {"id": "gridDoorsIn", "name": "Grid Doors In", "category": "in", "length": 1.0, "about": "tiles open like small doors from the middle out", "effects": [{"type": "gridWipe", "name": "Grid Doors In", "ease": "easy", "keys": {"completion": [[0, 100], [1, 0]]}, "props": {"tiles": 8, "reverseTransition": true}}]},
    {"id": "lensPopIn", "name": "Lens Pop In", "category": "in", "length": 1.0, "about": "swells out from its middle as the picture stretches into place", "effects": [{"type": "radialScaleWipe", "name": "Lens Pop In", "ease": "easy", "keys": {"completion": [[0, 100], [1, 0]]}, "props": {"reverseTransition": true}}]},
    {"id": "lineSweepIn", "name": "Line Sweep In", "category": "in", "length": 1.0, "about": "a stepped, slanted edge sweeps across and shows it", "effects": [{"type": "lineSweep", "name": "Line Sweep In", "ease": "easy", "keys": {"completion": [[0, 100], [1, 0]]}, "props": {"thickness": 30, "slant": 30}}]},
    {"id": "jawsIn", "name": "Jaws Close In", "category": "in", "length": 1.0, "about": "toothed edges close in from the top and bottom until it is whole", "effects": [{"type": "jaws", "name": "Jaws Close In", "ease": "easy", "keys": {"completion": [[0, 100], [1, 0]]}, "props": {"width": {"ofLayer": 0.08}}}]},
    {"id": "pulse", "name": "Pulse", "category": "loop", "about": "breathes in and out, once a second", "layer": {"expressions": {"transform/scale": "value * (1 + 0.06 * Math.sin(time * Math.PI * 2))"}}},
    {"id": "wiggle", "name": "Wiggle", "category": "loop", "about": "drifts about where it is, twice a second", "layer": {"expressions": {"transform/position": "wiggle(2, 20)"}}},
    {"id": "float", "name": "Float", "category": "loop", "about": "bobs gently up and down", "layer": {"expressions": {"transform/position": "value + [0, 12 * Math.sin(time * 2)]"}}},
    {"id": "spin", "name": "Spin", "category": "loop", "about": "turns round a quarter turn a second", "layer": {"expressions": {"transform/rotation": "value + time * 90"}}},
    {"id": "blink", "name": "Blink", "category": "loop", "about": "flashes off and on twice a second", "layer": {"expressions": {"transform/opacity": "Math.floor(time * 4) % 2 == 0 ? value : 0"}}},
    {"id": "typewriter", "name": "Typewriter", "category": "text", "length": 1.5, "about": "the letters appear one by one", "textAnimators": [{"name": "Typewriter", "props": {"opacity": 0}, "selectors": [{"type": "range", "keys": {"start": [[0, 0], [1, 100]]}}]}]},
    {"id": "wordsRise", "name": "Words Rise", "category": "text", "length": 1.2, "about": "the words rise into place one after another", "textAnimators": [{"name": "Words Rise", "props": {"position": [0, 60], "opacity": 0}, "selectors": [{"type": "range", "props": {"basedOn": "words", "shape": "rampUp", "easeLow": 60}, "keys": {"offset": [[0, -100], [1, 100]]}}]}]},
    {"id": "lettersFadeOut", "name": "Letters Fade Out", "category": "text", "length": 1.0, "at": "out", "about": "the letters go one by one, first to last", "textAnimators": [{"name": "Letters Fade Out", "props": {"opacity": 0}, "selectors": [{"type": "range", "keys": {"end": [[0, 0], [1, 100]]}}]}]},
    {"id": "lettersWiggle", "name": "Letters Wiggle", "category": "text", "about": "each letter jiggles on its own, for as long as the layer lasts", "textAnimators": [{"name": "Letters Wiggle", "props": {"position": [0, 8], "rotation": 6}, "selectors": [{"type": "range"}, {"type": "wiggly", "props": {"speed": 3, "correlation": 20}}]}]},
    {"id": "fadeUpCharacters", "name": "Fade Up Characters", "category": "text", "length": 1.2, "about": "the letters fade in as they rise into place, first to last", "textAnimators": [{"name": "Fade Up Characters", "props": {"position": [0, 40], "opacity": 0}, "selectors": [{"type": "range", "props": {"basedOn": "characters", "shape": "rampUp", "easeLow": 50}, "ease": "easy", "keys": {"offset": [[0, -100], [1, 100]]}}]}]},
    {"id": "wordsPop", "name": "Words Pop", "category": "text", "length": 1.0, "about": "the words grow from nothing, one after another", "textAnimators": [{"name": "Words Pop", "props": {"scale": [0, 0], "opacity": 0}, "selectors": [{"type": "range", "props": {"basedOn": "words", "shape": "rampUp"}, "ease": "easy", "keys": {"offset": [[0, -100], [1, 100]]}}]}]},
    {"id": "trackingIn", "name": "Tracking In", "category": "text", "length": 1.4, "about": "widely spaced text draws together as it fades in", "textAnimators": [{"name": "Tracking In", "props": {"tracking": 600, "opacity": 0}, "selectors": [{"type": "range", "ease": "easy", "keys": {"amount": [[0, 100], [1, 0]]}}]}]},
    {"id": "dropInLines", "name": "Drop In Lines", "category": "text", "length": 1.2, "about": "the lines drop in from above with a slight turn, one after another", "textAnimators": [{"name": "Drop In Lines", "props": {"position": [0, -40], "rotation": -8, "opacity": 0}, "selectors": [{"type": "range", "props": {"basedOn": "lines", "shape": "rampUp"}, "ease": "easy", "keys": {"offset": [[0, -100], [1, 100]]}}]}]},
    {"id": "softGradientDrift", "name": "Soft Gradient Drift", "category": "background", "about": "four soft colour corners slowly drift round the frame", "effects": [{"type": "fourColorGradient", "name": "Soft Gradient Drift", "props": {"color1": "#2b5876", "color2": "#4e4376", "color3": "#e96443", "color4": "#904e95", "blend": 160}, "expressions": {"point1": "value + [thisLayer.width * 0.08 * Math.sin(time * 0.5), thisLayer.height * 0.06 * Math.cos(time * 0.4)]", "point2": "value + [thisLayer.width * 0.07 * Math.cos(time * 0.45), thisLayer.height * 0.08 * Math.sin(time * 0.35)]", "point3": "value + [-thisLayer.width * 0.08 * Math.sin(time * 0.38), thisLayer.height * 0.06 * Math.cos(time * 0.52)]", "point4": "value + [thisLayer.width * 0.06 * Math.cos(time * 0.6), -thisLayer.height * 0.07 * Math.sin(time * 0.42)]"}}]},
    {"id": "auroraVeil", "name": "Aurora Veil", "category": "background", "about": "tall green curtains of light ripple slowly over a night sky", "effects": [{"type": "fractalNoise", "name": "Aurora", "props": {"uniformScaling": false, "scaleWidth": 40, "scaleHeight": 900, "contrast": 230, "brightness": -70, "complexity": 4}, "expressions": {"evolution": "time * 25", "offsetTurbulence": "value + [time * thisLayer.width * 0.03, 0]"}}, {"type": "tint", "name": "Aurora Colour", "props": {"mapBlackTo": "#030b1a", "mapWhiteTo": "#5dffb0"}}]},
    {"id": "slowFog", "name": "Slow Fog", "category": "background", "about": "heavy grey-blue fog banks roll gently through", "effects": [{"type": "fractalNoise", "name": "Fog", "props": {"scale": 450, "contrast": 150, "brightness": -10, "complexity": 5}, "expressions": {"evolution": "time * 8", "offsetTurbulence": "value + [time * thisLayer.width * 0.02, 0]"}}, {"type": "tint", "name": "Fog Colour", "props": {"mapBlackTo": "#1e2630", "mapWhiteTo": "#cfd8e0"}}]},
    {"id": "cloudBank", "name": "Cloud Bank", "category": "background", "about": "soft clouds drift across a blue sky", "effects": [{"type": "fractalNoise", "name": "Clouds", "props": {"scale": 350, "contrast": 230, "brightness": -45, "complexity": 7, "subInfluence": 60}, "expressions": {"evolution": "time * 6", "offsetTurbulence": "value + [time * thisLayer.width * 0.025, 0]"}}, {"type": "tint", "name": "Sky", "props": {"mapBlackTo": "#2f6fb5", "mapWhiteTo": "#ffffff"}}]},
    {"id": "darkSmoke", "name": "Dark Smoke", "category": "background", "about": "thick dark smoke rises slowly and curls", "effects": [{"type": "turbulentNoise", "name": "Smoke", "props": {"scale": 260, "contrast": 170, "brightness": -45, "turbulenceFactor": 0.8}, "expressions": {"evolution": "time * 20", "offsetTurbulence": "value - [0, time * thisLayer.height * 0.04]"}}, {"type": "tint", "name": "Smoke Colour", "props": {"mapBlackTo": "#050505", "mapWhiteTo": "#a0a0a0"}}]},
